Bootstrap: localimage
From: ccic_conda.sif

%files
    pansat /pansat
    ccic /ccic
    identities.json /pansat/identities.json

%environment
    export PATH="/opt/conda/bin:$PATH"
    export PATH="/opt/conda/envs/ccic/bin:$PATH"
    export PANSAT_IDENTITIES_FILE=/pansat/identities.json

%post
    /opt/conda/envs/ccic/bin/python3 -m pip install --no-cache-dir /pansat
    /opt/conda/envs/ccic/bin/python3 -m pip install --no-cache-dir torch==1.13.1+cu116 torchvision==0.14.1+cu116 --extra-index-url https://download.pytorch.org/whl/cu116
    /opt/conda/envs/ccic/bin/python3 -m pip install --no-cache-dir /ccic[complete]
    /opt/conda/envs/ccic/bin/python3 -m pip install --no-cache-dir notebook tensorboard

    echo ". /singularity_shell_init.sh" >> $SINGULARITY_ENVIRONMENT
    echo "micromamba activate ccic" >> $SINGULARITY_ENVIRONMENT

%runscript

    exec "$@"
    
